apiVersion: 1

deleteDatasources:
  - name: Prometheus
    orgId: 1
  - name: Loki
    orgId: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: "http://{{ hostvars[groups['prometheus_servers'][0]].ansible_host }}:{{ prometheus_port }}"
    isDefault: true
    editable: false
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: "http://{{ hostvars[groups['loki_servers'][0]].ansible_host }}:{{ loki_port }}"
    editable: false
